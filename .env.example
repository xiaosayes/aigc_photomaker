# Values here supply defaults; explicitly exported operational environment values win.
# install.sh fills this with a random 48-byte token when it is absent or empty.
AIGC_API_KEY=
# Conda environment to activate. Use your actual environment name.
AIGC_CONDA_ENV=photomaker
AIGC_GPU_ID=1
AIGC_OFFLINE=0
AIGC_INCLUDE_OPTIONAL_MODELS=0
AIGC_APP_HOST=0.0.0.0
AIGC_APP_PORT=8000
AIGC_COMFY_PORT=8188
AIGC_COMFY_DIR=.runtime/ComfyUI
AIGC_COMFY_EXTRA_ARGS=
AIGC_GPU_MIN_FREE_MIB=20480
AIGC_COMFY_START_TIMEOUT=300
AIGC_API_START_TIMEOUT=120

# Online mirrors. GITHUB_PROXY is prepended to the full GitHub URL when set.
HF_ENDPOINT=https://hf-mirror.com
PIP_INDEX_URL=https://pypi.org/simple
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
GITHUB_PROXY=

# Optional process-health overrides.
AIGC_WORKER_LEASE_SECONDS=60
AIGC_FLUX_STANDARD_UNET_FILENAME=flux-2-klein-4b-fp8.safetensors
AIGC_FLUX_TURBO_UNET_FILENAME=flux-2-klein-4b-fp8.safetensors
AIGC_FLUX_TEXT_ENCODER_FILENAME=qwen_3_4b.safetensors
AIGC_FLUX_VAE_FILENAME=flux2-vae.safetensors
AIGC_STANDARD_STEPS=8
AIGC_STANDARD_CFG=1.0
AIGC_TURBO_STEPS=4
AIGC_TURBO_CFG=1.0
AIGC_EXECUTION_TIMEOUT_SECONDS=120
AIGC_MULTIPART_OVERHEAD_BYTES=65536
AIGC_MIN_FREE_DISK_BYTES=1073741824
